# ── Discord bot ──────────────────────────────────────────────────────────
DISCORD_TOKEN=your-bot-token

# ── Dashboard server ─────────────────────────────────────────────────────
PORT=10000                          # Render sets this automatically — leave unset locally to default to 5000
BOT_DB_PATH=bot.db                  # on Render, point this at your persistent disk, e.g. /var/data/bot.db
DASHBOARD_API_KEY=                  # optional — only needed for server-to-server calls, not browser logins

# ── Discord OAuth2 (discord.com/developers/applications → your app → OAuth2) ─
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret
DISCORD_REDIRECT_URI=https://your-app.onrender.com/callback
FLASK_SECRET_KEY=generate-a-long-random-string   # e.g. python -c "import secrets; print(secrets.token_hex(32))"

# Frontend is served by this same app (frontend/dist) — no separate host,
# no FRONTEND_ORIGIN needed.
